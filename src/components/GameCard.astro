---
import { site, type Game } from '../lib/data';
import { url, GAME_TYPE, range } from '../lib/site';

interface Props { game: Game; educator?: boolean }
const { game, educator = false } = Astro.props;
const s = await site();
const world = s.world(game.data.world.id);
const topics = s.gameTopics(game);
const href = educator ? url(`educators/games/${game.id}/`) : url(`games/${game.id}/`);
---
<a class="card" href={href}>
  <span class="eyebrow accent">{GAME_TYPE[game.data.game_type]} · {world.data.name}</span>
  <h3>{game.data.name}</h3>
  <p>{game.data.summary}</p>
  <p class="meta">{range(game.data.players, 'players')} · {range(game.data.minutes, 'min')}</p>
  <ul class="chips" aria-label="Topics">
    {topics.map((t) => <li class="chip">{t.data.name}</li>)}
  </ul>
</a>
