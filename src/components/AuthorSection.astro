---
import type { Activity } from '../lib/data';

interface Props { activity: Activity }
const { author } = Astro.props.activity.data;
const people = author.name.split(/\s*,\s*(?:(?:and|&)\s+)?|\s+(?:and|&)\s+/).filter(Boolean);
const initials = (people.length > 1 ? people : author.name.split(/\s+/).slice(0, 2)).map((w) => w[0]).slice(0, 3).join('').toUpperCase();
---
<section class="on-navy band">
  <div class="wrap">
    <div class="card author">
      <div class="avatar" aria-hidden="true">{initials}</div>
      <div>
        <span class="eyebrow accent">About the {author.role}</span>
        <h2>{author.name}</h2>
        {author.bio && <p>{author.bio}</p>}
        {author.link && <a class="btn small" href={author.link.url} rel="noopener">{author.link.label}</a>}
      </div>
    </div>
  </div>
</section>

<style>
  .author { display: flex; gap: 32px; align-items: center; }
  .avatar {
    flex: none; width: 120px; height: 120px; border-radius: 50%; display: grid; place-items: center;
    background: var(--orange); color: var(--ink); border: 4px solid var(--ink);
    font: 700 2.6rem/1 var(--font-display);
  }
  h2 { font-size: 1.9rem; margin: 6px 0 10px; }
  p { max-width: 62ch; }
  @media (max-width: 600px) {
    .author { flex-direction: column; align-items: flex-start; gap: 20px; }
    .avatar { width: 88px; height: 88px; font-size: 1.9rem; }
  }
</style>
