---
import Base from '../layouts/Base.astro';
import DomainIcon from '../components/DomainIcon.astro';
import ActivityCard from '../components/ActivityCard.astro';
import { site } from '../lib/data';
import { url } from '../lib/site';

const s = await site();
---
<Base>
  <section class="on-navy band hero">
    <div class="wrap hero-grid">
      <div>
        <span class="pill">Offline · Grades 6–12</span>
        <h1>CS <span class="q">Offline</span></h1>
        <p class="tagline">Computer science, <span class="hl">offline</span>.</p>
        <p class="lead">Learn through games and activities with paper, cards, and the people around you, then find out how
          the same ideas work inside real computers, data, and AI.</p>
        <div class="actions">
          <a class="btn" href={url('domains/')}>Explore the domains →</a>
          <a class="btn light" href={url('educators/')}>For educators</a>
        </div>
      </div>
      <img class="hero-art" src={url('logo.png')} alt="An open book showing cards, layered sheets, and a network of connected nodes" width="323" height="228" />
    </div>
  </section>

  <section class="on-orange band">
    <div class="wrap">
      <div class="band-head">
        <span class="eyebrow">Six learning domains</span>
        <h2>Pick a domain. Try an activity.</h2>
        <p>Every activity lives in one learning domain, and most of its ideas reach into others.</p>
      </div>
      <div class="grid">
        {s.domains.map((d, i) => {
          const n = s.activitiesIn(d).length;
          return (
            <a class={`card ${i % 2 ? 'tilt-r' : 'tilt-l'}`} href={url(`domains/${d.id}/`)}>
              <div class={`tile tint-${d.data.color}`}><DomainIcon name={d.data.icon} /></div>
              <h3>{d.data.name}</h3>
              <p>{d.data.summary}</p>
              <p class="meta">{n ? `${n} ${n === 1 ? 'activity' : 'activities'}` : 'Activities coming soon'}</p>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <section class="on-orange band">
    <div class="wrap">
      <div class="band-head">
        <span class="eyebrow">How it works</span>
        <h2>Try it. Then see what's really going on.</h2>
      </div>
      <div class="grid">
        <div class="card tilt-l">
          <div class="tile tint-orange"><DomainIcon name="puzzle" /></div>
          <h3>Learn unplugged</h3>
          <p>Every activity uses paper, cards, or conversation. No devices, accounts, or Wi-Fi.</p>
        </div>
        <div class="card tilt-r">
          <div class="tile tint-sky"><DomainIcon name="chip" /></div>
          <h3>See the real thing</h3>
          <p>Each idea has a page that shows how it works in real computers, apps, and AI.</p>
        </div>
        <div class="card tilt-l">
          <div class="tile tint-mint"><DomainIcon name="chart" /></div>
          <h3>Teach it</h3>
          <p>Educators get guides, printables, and standards.</p>
        </div>
      </div>
    </div>
  </section>

  {s.studentActivities.length > 0 && (
    <section class="on-paper band">
      <div class="wrap">
        <div class="band-head">
          <span class="eyebrow accent">Activities</span>
          <h2>Ready to use</h2>
        </div>
        <div class="grid two">
          {s.studentActivities.map((g) => <ActivityCard activity={g} />)}
        </div>
      </div>
    </section>
  )}

  <section class="on-navy band">
    <div class="wrap" style="text-align:center">
      <h2>Bring it to your classroom</h2>
      <p class="lead" style="max-width:56ch;margin:0 auto 28px">Find an activity by domain, idea, grade, or time, then print everything you need.</p>
      <div class="actions" style="justify-content:center">
        <a class="btn" href={url('educators/')}>Open the activity catalog</a>
        <a class="btn light" href={url('activities/')}>Browse all activities</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { padding: 72px 0 96px; }
  .hero-grid { display: grid; grid-template-columns: 1.15fr .85fr; gap: 40px; align-items: center; }
  .hero h1 { margin: 22px 0 10px; }
  .q { color: var(--orange-bright); white-space: nowrap; }
  .tagline { font: 700 clamp(1.4rem, 2.6vw, 2rem)/1.25 var(--font-display); margin: 0 0 22px; }
  .hl { color: var(--orange-bright); position: relative; white-space: nowrap; }
  .hl::after {
    content: ''; position: absolute; left: 4%; right: 4%; bottom: -.08em; height: .14em;
    border-radius: 999px; background: var(--orange); transform: rotate(-1.5deg);
  }
  .lead { font-size: 1.2rem; max-width: 46ch; }
  .actions { display: flex; flex-wrap: wrap; gap: 18px; margin-top: 30px; }
  .hero-art { max-width: 440px; width: 100%; height: auto; justify-self: center; }
  @media (prefers-reduced-motion: no-preference) {
    .r1 { animation: spin 60s linear infinite; }
    @keyframes spin { to { transform: rotate(360deg); } }
  }
  @media (max-width: 860px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-art { max-width: 300px; }
  }
</style>
