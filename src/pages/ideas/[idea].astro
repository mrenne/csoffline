---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import ActivityCard from '../../components/ActivityCard.astro';
import { site, sections, type Idea } from '../../lib/data';
import { url } from '../../lib/site';

export async function getStaticPaths() {
  const s = await site();
  return s.ideas.map((c) => ({ params: { idea: c.id }, props: { idea: c } }));
}
const { idea } = Astro.props as { idea: Idea };
const s = await site();
await render(idea);
const parts = sections(idea.rendered?.html ?? '');
const student = parts['whats-really-going-on'];
const educator = ['background', 'misconceptions'].map((k) => parts[k]).filter(Boolean);
const activities = s.activitiesFor(idea);
const domains = s.ideaDomains(idea);
const related = idea.data.related.map((r) => s.idea(r.id));
---
<Base title={idea.data.name} description={idea.data.student_summary}>
  <PageHead
    eyebrow={domains.map((d) => d.data.name).join(' · ')}
    title={idea.data.name}
    lead={idea.data.student_summary}
    crumbs={[{ label: 'Domains', href: url('domains/') }, { label: domains[0].data.name, href: url(`domains/${domains[0].id}/`) }, { label: idea.data.name }]}
  />
  <section class="on-paper band">
    <div class="wrap layout">
      <div>
        <article class="card prose section-card" style="max-width:none">
          <h2>What's really going on</h2>
          {student ? <Fragment set:html={student.html} /> : <p class="note">This explanation has not been written yet.</p>}
        </article>
        {educator.length > 0 && (
          <details class="card prose section-card" style="max-width:none">
            <summary><strong style="font-family:var(--font-display);font-size:1.3rem">For educators</strong></summary>
            {educator.map((p) => <><h3>{p.title}</h3><Fragment set:html={p.html} /></>)}
          </details>
        )}
      </div>
      <aside>
        <div class="card">
          <h2 style="font-size:1.25rem">Domains</h2>
          <ul class="chips">{domains.map((d) => <li><a class="chip" href={url(`domains/${d.id}/`)}>{d.data.name}</a></li>)}</ul>
        </div>
        {related.length > 0 && (
          <div class="card">
            <h2 style="font-size:1.25rem">Related ideas</h2>
            <ul class="chips">{related.map((c) => <li><a class="chip" href={url(`ideas/${c.id}/`)}>{c.data.name}</a></li>)}</ul>
          </div>
        )}
      </aside>
    </div>
  </section>
  <section class="on-orange band">
    <div class="wrap">
      <div class="band-head">
        <span class="eyebrow">Try it</span>
        <h2>{activities.length ? `Activities about ${idea.data.name.toLowerCase()}` : 'Activities coming soon'}</h2>
      </div>
      <div class="grid two">{activities.map((g) => <ActivityCard activity={g} />)}</div>
    </div>
  </section>
</Base>

<style>
  details summary { cursor: pointer; list-style-position: outside; }
  details[open] summary { margin-bottom: 8px; }
</style>
