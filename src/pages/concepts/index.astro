---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import DomainIcon from '../../components/DomainIcon.astro';
import { site } from '../../lib/data';
import { url } from '../../lib/site';

const s = await site();
---
<Base title="Concepts" description="The ideas behind every CS Offline game, grouped by learning domain.">
  <PageHead eyebrow="Ideas" title="Concepts" lead="The ideas behind the games, grouped by learning domain. Each one shows how the idea works in real computers, and which games teach it." />
  <section class="on-paper band">
    <div class="wrap grid two">
      {s.domains.map((d) => {
        const list = s.conceptsFor(d);
        return (
          <section class="card">
            <div class={`tile tint-${d.data.color}`}><DomainIcon name={d.data.icon} /></div>
            <h2 style="font-size:1.5rem"><a href={url(`domains/${d.id}/`)}>{d.data.name}</a></h2>
            {list.length ? (
              <ul class="stack">
                {list.map((c) => (
                  <li><a class="row-link" href={url(`concepts/${c.id}/`)}><span><strong>{c.data.name}</strong><span>{c.data.student_summary}</span></span></a></li>
                ))}
              </ul>
            ) : <p class="meta">Concepts for this domain are coming soon.</p>}
          </section>
        );
      })}
    </div>
  </section>
</Base>
