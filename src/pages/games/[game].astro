---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Facts from '../../components/Facts.astro';
import GameCard from '../../components/GameCard.astro';
import { site, type Game } from '../../lib/data';
import { url, GAME_TYPE } from '../../lib/site';

export async function getStaticPaths() {
  const s = await site();
  return s.games.map((g) => ({ params: { game: g.id }, props: { game: g } }));
}
const { game } = Astro.props as { game: Game };
const s = await site();
const { Content } = await render(game);
const world = s.world(game.data.world.id);
const concepts = s.gameConcepts(game);
const next = s.pairsWith(game).slice(0, 2);
---
<Base title={game.data.name} description={game.data.summary}>
  <PageHead
    eyebrow={`${GAME_TYPE[game.data.game_type]} · ${world.data.name}`}
    title={game.data.name}
    lead={game.data.summary}
    crumbs={[{ label: 'Worlds', href: url('worlds/') }, { label: world.data.name, href: url(`worlds/${world.id}/`) }, { label: game.data.name }]}
  />
  <section class="on-paper band">
    <div class="wrap layout">
      <article class="card prose" style="max-width:none"><Content /></article>
      <aside>
        <div class="card">
          <h2 style="font-size:1.25rem">At a glance</h2>
          <Facts game={game} />
        </div>
        <div class="card">
          <h2 style="font-size:1.25rem">What's really going on</h2>
          <p>This game is about these ideas. Open one to see how it works in real computers.</p>
          <ul class="chips">
            {concepts.map((c) => <li><a class="chip" href={url(`concepts/${c.id}/`)}>{c.data.name}</a></li>)}
          </ul>
        </div>
        <div class="card">
          <h2 style="font-size:1.25rem">Teaching this game?</h2>
          <p>The educator guide has setup, printables, the debrief, and standards.</p>
          <a class="btn small" href={url(`educators/games/${game.id}/`)}>Educator guide</a>
        </div>
      </aside>
    </div>
  </section>
  {next.length > 0 && (
    <section class="on-orange band">
      <div class="wrap">
        <div class="band-head">
          <span class="eyebrow">Keep exploring</span>
          <h2>The same ideas, in another world</h2>
        </div>
        <div class="grid two">{next.map((g) => <GameCard game={g} />)}</div>
      </div>
    </section>
  )}
</Base>
