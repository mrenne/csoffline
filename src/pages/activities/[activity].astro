---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import AuthorSection from '../../components/AuthorSection.astro';
import Facts from '../../components/Facts.astro';
import ActivityCard from '../../components/ActivityCard.astro';
import { site, type Activity } from '../../lib/data';
import { url, ACTIVITY_TYPE } from '../../lib/site';

export async function getStaticPaths() {
  const s = await site();
  return s.studentActivities.map((g) => ({ params: { activity: g.id }, props: { activity: g } }));
}
const { activity } = Astro.props as { activity: Activity };
const s = await site();
const { Content } = await render(activity);
const domain = s.domain(activity.data.domain.id);
const ideas = s.activityIdeas(activity);
const next = s.pairsWith(activity).filter((a) => a.data.audience !== 'educators').slice(0, 2);
---
<Base title={activity.data.name} description={activity.data.summary}>
  <PageHead
    eyebrow={`${ACTIVITY_TYPE[activity.data.activity_type]} · ${domain.data.name}`}
    title={activity.data.name}
    lead={activity.data.summary}
    crumbs={[{ label: 'Domains', href: url('domains/') }, { label: domain.data.name, href: url(`domains/${domain.id}/`) }, { label: activity.data.name }]}
  />
  <section class="on-paper band">
    <div class="wrap layout">
      <article class="card prose" style="max-width:none"><Content /></article>
      <aside>
        <div class="card">
          <h2 style="font-size:1.25rem">At a glance</h2>
          <Facts activity={activity} />
        </div>
        <div class="card">
          <h2 style="font-size:1.25rem">What's really going on</h2>
          <p>This activity is about these ideas. Open one to see how it works in real computers.</p>
          <ul class="chips">
            {ideas.map((c) => <li><a class="chip" href={url(`ideas/${c.id}/`)}>{c.data.name}</a></li>)}
          </ul>
        </div>
        {activity.data.audience === 'both' && (
          <div class="card">
            <h2 style="font-size:1.25rem">Teaching this activity?</h2>
            <p>The educator guide has setup, printables, the debrief, and standards.</p>
            <a class="btn small" href={url(`educators/activities/${activity.id}/`)}>Educator guide</a>
          </div>
        )}
      </aside>
    </div>
  </section>
  <AuthorSection activity={activity} />
  {next.length > 0 && (
    <section class="on-orange band">
      <div class="wrap">
        <div class="band-head">
          <span class="eyebrow">Keep exploring</span>
          <h2>More activities with the same ideas</h2>
        </div>
        <div class="grid two">{next.map((g) => <ActivityCard activity={g} />)}</div>
      </div>
    </section>
  )}
</Base>
