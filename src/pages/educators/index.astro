---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import ActivityCard from '../../components/ActivityCard.astro';
import { site } from '../../lib/data';
import { ACTIVITY_TYPE } from '../../lib/site';

const s = await site();
const ideas = s.ideas.filter((c) => s.activitiesFor(c).length);
const types = [...new Set(s.educatorActivities.map((g) => g.data.activity_type))];
---
<Base title="Educators" description="Find an unplugged CS Offline activity by domain, idea, grade, time, or group size.">
  <PageHead eyebrow="For educators" title="Activity catalog"
    lead="Unplugged activities and resources for teaching, and for talking with other educators. Filter by what you need." />
  <section class="on-paper band">
    <div class="wrap">
      <form class="filters" id="filters" aria-label="Filter activities" hidden>
        <label>Domain
          <select name="domain">
            <option value="">All domains</option>
            {s.domains.map((d) => <option value={d.id}>{d.data.name}</option>)}
          </select>
        </label>
        <label>Idea
          <select name="idea">
            <option value="">All ideas</option>
            {ideas.map((c) => <option value={c.id}>{c.data.name}</option>)}
          </select>
        </label>
        <label>Grades
          <select name="grades">
            <option value="">All grades</option>
            <option value="6-8">6–8</option>
            <option value="9-12">9–12</option>
          </select>
        </label>
        <label>Time
          <select name="time">
            <option value="">Any length</option>
            <option value="30">Up to 30 minutes</option>
            <option value="50">Up to 50 minutes</option>
          </select>
        </label>
        <label>Type
          <select name="type">
            <option value="">All types</option>
            {types.map((t) => <option value={t}>{ACTIVITY_TYPE[t]}</option>)}
          </select>
        </label>
        <output id="count" aria-live="polite"></output>
      </form>
      <ul class="grid two" id="results" style="list-style:none;margin:0;padding:0">
        {s.educatorActivities.map((g) => (
          <li
            data-domains={s.activityDomains(g).map((d) => d.id).join(' ')}
            data-ideas={g.data.ideas.map((c) => c.id).join(' ')}
            data-grades={(g.data.grade_bands ?? []).join(' ')}
            data-minutes={g.data.minutes?.min ?? ''}
            data-type={g.data.activity_type}
          ><ActivityCard activity={g} educator /></li>
        ))}
      </ul>
      <p id="none" class="note" hidden>No activities match those filters yet.</p>
    </div>
  </section>
</Base>

<script>
  // Filters are an enhancement: without JavaScript every activity is listed.
  const form = document.getElementById('filters') as HTMLFormElement;
  const items = [...document.querySelectorAll<HTMLLIElement>('#results > li')];
  const count = document.getElementById('count')!;
  const none = document.getElementById('none')!;
  form.hidden = false;

  const params = new URLSearchParams(location.search);
  for (const el of form.elements) {
    const s = el as HTMLSelectElement;
    if (s.name && params.has(s.name)) s.value = params.get(s.name)!;
  }

  function apply() {
    const f = Object.fromEntries(new FormData(form)) as Record<string, string>;
    let shown = 0;
    for (const li of items) {
      const d = li.dataset;
      const ok = (!f.domain || d.domains!.split(' ').includes(f.domain))
        && (!f.idea || d.ideas!.split(' ').includes(f.idea))
        && (!f.grades || d.grades!.split(' ').includes(f.grades))
        && (!f.time || Number(d.minutes) <= Number(f.time))
        && (!f.type || d.type === f.type);
      li.hidden = !ok;
      if (ok) shown++;
    }
    count.textContent = `${shown} ${shown === 1 ? 'activity' : 'activities'}`;
    none.hidden = shown > 0;
    const q = new URLSearchParams(Object.entries(f).filter(([, v]) => v));
    history.replaceState(null, '', q.toString() ? `?${q}` : location.pathname);
  }
  form.addEventListener('change', apply);
  apply();
</script>
