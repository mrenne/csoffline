---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { site } from '../../lib/data';
import { url } from '../../lib/site';

const s = await site();
---
<Base title="Worlds" description="All the worlds of CS Worlds, each with its own story and unplugged games.">
  <PageHead eyebrow="Explore" title="The worlds" lead="Each world is a place with its own story and rules. Pick one, learn its games, and play them with your class or friends." />
  <section class="on-orange band">
    <div class="wrap">
      <ol class="grid two" style="list-style:none;margin:0;padding:0">
        {s.worlds.map((w, i) => (
          <li>
            <a class={`card ${i % 2 ? 'tilt-r' : 'tilt-l'}`} href={url(`worlds/${w.id}/`)}>
              <span class="eyebrow">World {i + 1}</span>
              <h2 style="font-size:1.7rem">{w.data.name}</h2>
              <p>{w.data.tagline}</p>
              <p class="meta">{s.gamesInWorld(w).map((g) => g.data.name).join(', ') || 'Games coming soon'}</p>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>
</Base>
