---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import GameCard from '../../components/GameCard.astro';
import { site, type World } from '../../lib/data';
import { url } from '../../lib/site';

export async function getStaticPaths() {
  const s = await site();
  return s.worlds.map((w) => ({ params: { world: w.id }, props: { world: w } }));
}
const { world } = Astro.props as { world: World };
const s = await site();
const { Content } = await render(world);
const games = s.gamesInWorld(world);
const concepts = s.worldConcepts(world);
const others = s.worlds.filter((w) => w.id !== world.id);
---
<Base title={world.data.name} description={world.data.tagline}>
  <PageHead
    eyebrow="World"
    title={world.data.name}
    lead={world.data.tagline}
    crumbs={[{ label: 'Worlds', href: url('worlds/') }, { label: world.data.name }]}
  />
  <section class="on-paper band">
    <div class="wrap layout">
      <div>
        {world.data.art && (
          <Image src={world.data.art} alt={world.data.art_alt ?? ''} class="card" style="padding:0;margin-bottom:32px;width:100%;height:auto" />
        )}
        <article class="card prose" style="max-width:none"><Content /></article>
      </div>
      <aside>
        {concepts.length > 0 && (
          <div class="card">
            <h2 style="font-size:1.25rem">Ideas in this world</h2>
            <ul class="chips">
              {concepts.map((c) => <li><a class="chip" href={url(`concepts/${c.id}/`)}>{c.data.name}</a></li>)}
            </ul>
          </div>
        )}
        {others.length > 0 && (
          <div class="card">
            <h2 style="font-size:1.25rem">Other worlds</h2>
            <ul class="stack">
              {others.map((w) => <li><a class="row-link" href={url(`worlds/${w.id}/`)}><span><strong>{w.data.name}</strong><span>{w.data.tagline}</span></span></a></li>)}
            </ul>
          </div>
        )}
      </aside>
    </div>
  </section>
  <section class="on-orange band">
    <div class="wrap">
      <div class="band-head">
        <span class="eyebrow">Games in {world.data.name}</span>
        <h2>{games.length ? 'Play here' : 'Games coming soon'}</h2>
      </div>
      <div class="grid two">
        {games.map((g) => <GameCard game={g} />)}
      </div>
    </div>
  </section>
</Base>
